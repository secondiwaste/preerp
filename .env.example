# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=preerp_db
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Log Configuration
# Number of days to keep log entries (older logs will be deleted automatically)
LOG_RETENTION_DAYS=90

# Logging Level (DEBUG, INFO, SUCCESS, WARN, ERROR)
# Controls which messages are logged to console and database
# LOG_LEVEL=INFO

# Disable Console Logging
# Set to 'true' to completely disable all console.log output from Logger module
# Database logging will still work - only console output is disabled
# Useful for performance testing or production environments
# DISABLE_CONSOLE_LOGS=false
