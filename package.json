{
  "name": "preerp",
  "version": "1.0.0",
  "description": "Full-stack Node.js application with Angular frontend and Express backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build:frontend": "cd frontend && npm run build",
    "watch:frontend": "cd frontend && npm run watch",
    "install:all": "npm install && cd frontend && npm install",
    "postinstall": "cd frontend && npm install",
    "migration:status": "node scripts/migration-status.js"
  },
  "keywords": ["nodejs", "express", "angular", "mysql", "authentication"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
