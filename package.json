{
  "name": "preerp",
  "version": "1.0.0",
  "description": "Full-stack Node.js application with Angular frontend and Express backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build:frontend": "cd frontend && npm run build",
    "watch:frontend": "cd frontend && npm run watch",
    "install:all": "npm install && cd frontend && npm install",
    "postinstall": "cd frontend && npm install",
    "migration:status": "node scripts/migration-status.js",
    "create-archive": "node scripts/create-release-archive.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "nodejs",
    "express",
    "angular",
    "mysql",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "archiver": "^7.0.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.0.2"
  }
}
